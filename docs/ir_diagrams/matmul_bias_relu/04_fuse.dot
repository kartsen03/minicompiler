digraph "matmul_bias_relu" {
  graph [rankdir=TB, fontname="Helvetica", fontsize=13, labelloc=t, label="matmul_bias_relu: after pass 4 (fuse)\n5 nodes, 2 compute (2 elementwise ops, 1 matmul)"];
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled"];
  edge [color="#4b5563", arrowsize=0.7];
  n0 [label="x\ninput\nf32[256,1024]", shape=ellipse, style=filled, fillcolor="#dbeafe"];
  n1 [label="w\nconst <1048576 values>\nf32[1024,1024]", style=filled, fillcolor="#e5e7eb"];
  n2 [label="b\nconst <1024 values>\nf32[1024]", style=filled, fillcolor="#e5e7eb"];
  n3 [label="h\nmatmul\nf32[256,1024]", fillcolor="#fed7aa"];
  n4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>y</B></TD></TR><TR><TD>fused: 2 ops</TD></TR><TR><TD>f32[256,1024]</TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="9">r0 = load h<BR ALIGN="LEFT"/>r1 = load b<BR ALIGN="LEFT"/>r2 = add r0, r1<BR ALIGN="LEFT"/>r3 = relu r2<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>, color="#16a34a", fillcolor="#dcfce7", peripheries=2, penwidth=1.5];
  n0 -> n3;
  n1 -> n3;
  n3 -> n4;
  n2 -> n4;
}
